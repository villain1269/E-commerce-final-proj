APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Email (order confirmations)
# ---------------------------------------------------------------------------
# By default, emails are written to storage/logs/laravel.log instead of being
# actually sent. This is the safest setting for local development.
#
# To send REAL emails, change MAIL_MAILER to one of: smtp, sendmail, ses, etc.
# For Gmail SMTP (free, easy for school projects):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=yourgmail@gmail.com
#   MAIL_PASSWORD=your_app_password    ← use an App Password, NOT your real password
#   MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS=yourgmail@gmail.com
#
# To get a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (if not already)
#   3. Search for "App passwords" → create one for "Mail"
#   4. Copy the 16-char password and paste it below
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="orders@daniellescraftedpizza.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Payment gateway
# ---------------------------------------------------------------------------
# By default, this project uses a built-in MOCK payment gateway at /mock/{ref}
# that requires no API keys, no signup, no business documents.
#
# To use REAL Xendit test mode instead, sign up at https://dashboard.xendit.co,
# go to Settings → API Keys, generate a secret key (xnd_secret_development_...
# or xnd_development_... for older accounts), and paste both keys below.
# When both XENDIT_SECRET_KEY and XENDIT_PUBLIC_KEY are present and non-empty,
# the payment flow will use real Xendit test mode. Otherwise the mock is used.
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=

# Optional: webhook verification token from Xendit dashboard (Settings → Webhooks)
# Used to verify that incoming /payment/webhook requests are really from Xendit.
XENDIT_WEBHOOK_TOKEN=
